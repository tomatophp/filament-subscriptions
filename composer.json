{
    "name": "tomatophp/filament-subscriptions",
    "type": "library",
    "description": "Manage subscriptions and feature access with customizable plans in FilamentPHP",
    "keywords": [
        "php",
        "laravel",
        "template"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TomatoPHP\\FilamentSubscriptions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TomatoPHP\\FilamentSubscriptions\\FilamentSubscriptionsServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Abdelmjid Saber",
            "email": "AbdelmjidDev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "laravelcm/laravel-subscriptions": "^1.5",
        "tomatophp/console-helpers": "^1.1",
        "tomatophp/filament-locations": "^5.0",
        "tomatophp/filament-translation-component": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "pestphp/pest-plugin-livewire": "^4.0|^5.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "version": "5.0.0"
}
